{
  "name": "jobpay-agent",
  "version": "1.0.0",
  "description": "Agentic PayPal back-office for home-service crews: onboard workers, close out jobs, pay via PayPal Payouts, bill via Invoicing/Orders \u2014 every dollar human-approved. PayPal AI Hackathon 2026.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "llm:local": "bash scripts/local-llm.sh",
    "eval:planner": "bun run scripts/eval-planner.ts"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.1"
  }
}