# --- PayPal (SANDBOX ONLY) ---------------------------------------------
# Create an app: https://developer.paypal.com/dashboard/applications/sandbox
# Leave empty to run in DRY-RUN mode (every flow still works, no network calls).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Optional LLM planner (the offline planner works without any key) ---
# OpenAI:            OPENAI_API_KEY=sk-...
# Free/local Ollama: OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Guardrails ---------------------------------------------------------
JOBPAY_MAX_PAYOUT=500
JOBPAY_DAILY_CAP=2000
JOBPAY_MAX_INVOICE=10000
RATE_LIMIT_PER_MIN=90

# --- Server -------------------------------------------------------------
PORT=3000
# PUBLIC_URL=https://your-app.onrender.com   # PayPal checkout return URL (Render sets RENDER_EXTERNAL_URL automatically)
